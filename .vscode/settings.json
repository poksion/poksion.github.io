{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "chat.tools.terminal.autoApprove": {
        "/^powershell(?:\\.exe)? -NoProfile -Command \"\\[TimeZoneInfo\\]::ConvertTimeBySystemTimeZoneId\\(\\[DateTimeOffset\\]::UtcNow, 'Korea Standard Time'\\)\\.ToString\\('yyyy-MM-dd HH:mm:ss zzz'\\)\"$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^.*\\$timestamp = \\[TimeZoneInfo\\]::ConvertTimeBySystemTimeZoneId\\(\\[DateTimeOffset\\]::UtcNow, 'Korea Standard Time'\\)\\.ToString\\('yyyy-MM-dd HH:mm:ss zzz'\\); \\$path = '_posts\\/\\d{4}-\\d{2}-[^']+\\.md'; Write-Output \"Timestamp: \\$timestamp\"; Write-Output \"Exists: \\$\\(Test-Path -LiteralPath \\$path -PathType Leaf\\).*$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "window.commandCenter": false
}